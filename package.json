{
  "name": "dsh-study",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Study mode: a reading panel for PDF, Markdown, Word and PowerPoint with region capture and in-chat questions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mist-people/dsh-study.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/pdfjs/build/*.mjs",
    "vendor/pdfjs/wasm/*",
    "vendor/pdfjs/standard_fonts/*",
    "vendor/pdfjs/cmaps/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
